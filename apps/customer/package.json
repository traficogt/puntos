{
  "name": "@puntosfieles/customer",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export": "expo export --platform all",
    "export:web": "expo export --platform web",
    "lint": "eslint App.tsx src tests scripts plugins --max-warnings=0",
    "check:xcode-cloud": "node scripts/check-xcode-cloud.mjs",
    "postinstall": "node scripts/patch-query-string.mjs"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "query-string": "7.1.3",
    "decode-uri-component": "0.5.1",
    "@expo/fingerprint@0.20.15": {
      "glob": "14.0.4",
      "minimatch": "11.0.8"
    },
    "@typescript-eslint/typescript-estree@8.72.2": {
      "minimatch": "11.0.8"
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
