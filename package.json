{
  "name": "puntos",
  "version": "1.3.7",
  "description": "Self-hosted loyalty & rewards system for Guatemala (MIT, no Twilio)",
  "type": "module",
  "main": "src/app/server.js",
  "scripts": {
    "start": "node src/app/server.js",
    "worker": "node src/app/worker.js",
    "openapi:generate": "node src/scripts/generate-openapi.mjs",
    "dev": "NODE_ENV=development node --watch src/app/server.js",
    "test": "NODE_ENV=test node --test tests/unit/*.test.js && npm run test:integration",
    "test:unit": "NODE_ENV=test node --test tests/unit/*.test.js",
    "test:integration": "npm run test:integration:core && npm run test:integration:pwa",
    "test:integration:all": "npm run test:integration",
    "test:integration:core": "NODE_ENV=test node --test --test-concurrency=1 tests/integration/api-security.test.js tests/integration/customer-flow.test.js tests/integration/external-award-idempotency.test.js tests/integration/gift-card-idempotency.test.js tests/integration/orders-idempotency.test.js tests/integration/plan-enforcement.test.js tests/integration/recurring-gamification.test.js tests/integration/refund-gamification.test.js tests/integration/staff-ledger-idempotency.test.js tests/integration/super-giftcards.test.js",
    "test:integration:pwa": "node src/scripts/run-pwa-integration.mjs",
    "test:integration:live": "NODE_ENV=test node --test tests/integration/refund-gamification.test.js tests/integration/recurring-gamification.test.js",
    "test:watch": "NODE_ENV=test node --test --watch tests/unit/*.test.js tests/integration/*.test.js",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage tests/unit/*.test.js tests/integration/*.test.js",
    "typecheck": "tsc --noEmit --singleThreaded",
    "typecheck:focused": "tsc --noEmit --singleThreaded",
    "lint": "eslint src public tests --ext .js,.mjs,.cjs --max-warnings=0",
    "test:e2e": "bash src/scripts/run-e2e-isolated.sh",
    "test:e2e:local": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:visual": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/e2e/visual.spec.js",
    "test:e2e:visual:update": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/e2e/visual.spec.js --update-snapshots",
    "test:e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium firefox",
    "test:e2e:install:deps": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --with-deps chromium firefox",
    "ops:migrate": "node src/scripts/migrations.mjs apply",
    "ops:migrate:status": "node src/scripts/migrations.mjs status",
    "ops:migrate:doctor": "node src/scripts/migrations-doctor.mjs",
    "ops:migrate:smoke": "bash src/scripts/migration-smoke.sh",
    "ops:migrate:lock": "node src/scripts/migrations-lock.mjs --write",
    "ops:migrate:lock-check": "node src/scripts/migrations-lock.mjs",
    "ops:release:checklist": "node src/scripts/release-checklist.mjs",
    "ops:release:snapshot": "node src/scripts/release-snapshot.mjs",
    "ops:release:tag-local": "bash src/scripts/tag-local-release.sh",
    "ops:ledger:reconcile": "node src/scripts/reconcile-ledger.mjs",
    "ops:ledger:certify": "node src/scripts/generate-ledger-certification.mjs",
    "ops:ledger:certify:prune": "node src/scripts/prune-ledger-certifications.mjs",
    "ops:create-app-role": "node src/scripts/create-app-role.mjs",
    "ops:security-scan": "node src/scripts/security-scan.mjs",
    "ops:perf-sanity": "node src/scripts/perf-sanity.mjs",
    "ops:load:critical": "node src/scripts/load-critical.mjs",
    "ops:alerts:check": "node src/scripts/alert-check.mjs",
    "ops:alerts:drill": "bash src/scripts/alerts-drill.sh",
    "ops:smoke": "node src/scripts/deploy-smoke.mjs",
    "ops:backup": "bash src/scripts/backup-db.sh",
    "ops:backup:verify": "node src/scripts/verify-backup.mjs",
    "ops:restore": "bash src/scripts/restore-db.sh",
    "ops:restore:drill": "bash src/scripts/restore-drill.sh",
    "ops:rollback:local-image": "bash src/scripts/rollback-local-image.sh",
    "ops:rollback:verify": "node src/scripts/rollback-verify.mjs",
    "ops:failure:drill": "bash src/scripts/failure-drill.sh",
    "ops:backup:retention": "bash src/scripts/backup-retention.sh --apply",
    "ops:backup:health": "bash src/scripts/backup-health.sh",
    "ops:rls-check": "node src/scripts/rls-check.mjs",
    "ops:staff-ledger:check": "node src/scripts/live-staff-ledger-check.mjs",
    "ops:wallet:doctor": "node src/scripts/wallet-doctor.mjs",
    "test:wallet": "NODE_ENV=test node --test tests/unit/native-wallet*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "argon2": "0.45.2",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-stringify": "6.9.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "luxon": "3.7.2",
    "nanoid": "6.0.2",
    "node-cron": "4.6.0",
    "nodemailer": "10.5.0",
    "passkit-generator": "3.7.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "redis": "6.3.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7",
    "@prometheus-io/client": "0.16.1"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "qs": "6.16.2",
    "joi": "17.13.9",
    "eslint": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.8"
    }
  }
}
