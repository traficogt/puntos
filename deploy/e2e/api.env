NODE_ENV=test
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=1
DB_HOST=db
DB_PORT=5432
DB_NAME=puntos_e2e
AUTO_APPLY_MIGRATIONS=true
RATE_LIMIT_DRIVER=redis
REDIS_URL=redis://redis:6379
SUPER_ADMIN_EMAIL=super@example.com
# Isolated stacks must never reach the production mail relay or inbox.
CONTACT_SMTP_HOST=
CONTACT_TO=
# Billing stays unconfigured: checkout routes answer 503 BILLING_UNAVAILABLE and the
# live suite drives subscriptions through an injected fake provider, never Recurrente.
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
