# PuntosFieles - example environment
# Copy to .env and fill in values. In production, placeholders will FAIL FAST.

NODE_ENV=production
PORT=3001
SECRETS_DIR=/var/lib/puntos/secrets

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=puntos
DB_USER=puntos_app
DB_PASSWORD_FILE=/app/.secrets/db_password
DB_MIGRATIONS_USER=puntos_app
DB_MIGRATIONS_PASSWORD_FILE=/app/.secrets/db_migrations_password

# Security
JWT_SECRET_FILE=/app/.secrets/jwt_secret

# QR signing keys (Ed25519 PEM). Required for the core scan flow.
# Generate example:
#   openssl genpkey -algorithm Ed25519 -out qr-private.pem
#   openssl pkey -in qr-private.pem -pubout -out qr-public.pem
QR_PRIVATE_KEY_PEM_FILE=/app/.secrets/qr_private_key.pem
QR_PUBLIC_KEY_PEM_FILE=/app/.secrets/qr_public_key.pem

# Reverse proxy / HTTPS
# Set to 1 only when all inbound traffic comes through a trusted reverse proxy hop.
TRUST_PROXY=0
CORS_ORIGIN=https://puntofieles.yourdomain.com
APP_ORIGIN=https://puntofieles.yourdomain.com
MARKETING_ORIGIN=https://puntosfieles.com

# Cron / timezone
TZ=America/Guatemala
CRON_TZ=America/Guatemala
CHURN_DAYS=30
CHURN_SEND_HOUR_LOCAL=9
LEDGER_CERTIFICATION_RETENTION_DAYS=90
# Safer production default: run schema/migrations explicitly in deployment pipeline.
AUTO_APPLY_SCHEMA_EXTENSIONS=false
AUTO_APPLY_MIGRATIONS=false

# Messaging provider order. Leave MESSAGE_PROVIDER=dev for local mock flows if desired.
MESSAGE_PROVIDER=dev
MESSAGE_PROVIDER_ORDER=smtp_email
# Applies to WAHA and Evolution; clamped to 100–30000 ms (default 10000).
MESSAGE_PROVIDER_TIMEOUT_MS=10000
SMTP_HOST=10.10.1.20
SMTP_PORT=26
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hola@puntosfieles.com

# For WhatsApp, add waha to MESSAGE_PROVIDER_ORDER only after its phone is linked.
# Use Evolution as a manual alternative. An uncertain send never triggers fallback.
# API keys stay in server-only files mounted read-only in API and worker containers.
WAHA_BASE_URL=
WAHA_API_KEY_FILE=
# WAHA_API_KEY_FILE=/app/.secrets/waha_api_key
WAHA_SESSION=default

EVOLUTION_BASE_URL=
EVOLUTION_API_KEY_FILE=
# EVOLUTION_API_KEY_FILE=/app/.secrets/evolution_api_key
EVOLUTION_INSTANCE=

BAILEYS_BASE_URL=
BAILEYS_SEND_URL=
BAILEYS_API_KEY=

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v21.0

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Marketing contact form
CONTACT_SMTP_HOST=10.10.1.20
CONTACT_SMTP_PORT=26
CONTACT_TO=hola@puntosfieles.com
CONTACT_FROM=hola@puntosfieles.com
CONTACT_TURNSTILE_SECRET=

# Webhooks
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_CONCURRENCY=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_REQUIRE_HTTPS=true
# Optional dedicated key for encrypting webhook endpoint secrets at rest.
# If empty, the app falls back to JWT_SECRET-derived key material.
WEBHOOK_SECRET_ENC_KEY_FILE=/app/.secrets/webhook_secret_enc_key
# Optional previous keys accepted for decryption during key rotation.
# Comma-separated, old->new order does not matter.
WEBHOOK_SECRET_ENC_KEY_PREVIOUS=
# Optional allowlist: comma-separated domains (e.g. example.com, hooks.zapier.com)
WEBHOOK_ALLOWLIST=
# Require provider auth (secret or HMAC) for /public/payments/webhook/*
PAYMENT_WEBHOOK_REQUIRE_AUTH=true
# Optional JSON secret maps in the external secrets directory. Leave unset until
# a merchant integration is configured; do not put signing keys in this file.
# HMAC keys are indexed by businessSlug for the external-award API, or by
# provider for payment webhooks. Container paths use the existing secret mount.
PAYMENT_WEBHOOK_HMAC_SECRETS_FILE=
PAYMENT_WEBHOOK_SECRETS_FILE=
PAYMENT_WEBHOOK_ALLOWED_PROVIDERS=cubo,paybi,qpaypro,neonet
# Protect /api/metrics in production (send as Bearer token or x-metrics-token)
METRICS_TOKEN_FILE=/app/.secrets/metrics_token

# Platform super admin login (for /super)
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
# Prefer hashed secret in production:
#   node -e "import bcrypt from 'bcryptjs'; bcrypt.hash(process.argv[1], 12).then(v=>console.log(v))" "YOUR_PASSWORD"
SUPER_ADMIN_PASSWORD_HASH_FILE=/app/.secrets/super_admin_password_hash

# Native loyalty cards (opt-in; remain disabled while issuer verification is pending).
# Mount credential files read-only into BOTH API and worker. Never put keys in public/.
APPLE_WALLET_ENABLED=false
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE_FILE=
APPLE_WALLET_PRIVATE_KEY_FILE=
APPLE_WALLET_KEY_PASSPHRASE_FILE=
APPLE_WALLET_WWDR_FILE=
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=
# Optional public HTTPS image; defaults to APP_ORIGIN/images/wallet/google-logo.png.
GOOGLE_WALLET_LOGO_URL=
WALLET_ORGANIZATION_NAME=PuntosFieles

# Persist explicit images when deploying a scoped release without rebuilding.
PUNTOS_API_IMAGE=puntos-api
PUNTOS_WORKER_IMAGE=puntos-worker

# Native iPhone alerts (production APNs only; independent of Wallet).
# Keep disabled until the production app entitlement and APNs key are ready.
MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_APNS_TEAM_ID=
MOBILE_PUSH_APNS_KEY_ID=
MOBILE_PUSH_APNS_KEY_FILE=
MOBILE_PUSH_APNS_TOPIC=com.puntosfieles.customer
