{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "/lib.js": [
        "../../src/types/public-lib.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
