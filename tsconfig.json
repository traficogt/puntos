{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "useUnknownInCatchVariables": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "/idb.js": [
        "./src/types/public-idb.d.ts"
      ],
      "/lib.js": [
        "./src/types/public-lib.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "public/admin-dashboard/core.js",
    "public/admin-dashboard/view-state.js",
    "public/admin-dashboard/modules/analytics.js",
    "public/admin-dashboard/modules/analytics/audit.js",
    "public/admin-dashboard/modules/analytics/cohorts.js",
    "public/admin-dashboard/modules/analytics/dashboard.js",
    "public/admin-dashboard/modules/analytics/operations.js",
    "public/admin-dashboard/modules/analytics/render.js",
    "public/admin-dashboard/modules/program.js",
    "public/admin-dashboard/modules/program-form.js",
    "public/admin.js",
    "public/admin-dashboard/types.ts",
    "public/customer/index.js",
    "public/customer/load.js",
    "public/customer/me.js",
    "public/customer/network.js",
    "public/customer/qr.js",
    "public/customer/render.js",
    "public/session-epoch.js",
    "public/staff-login.js",
    "public/staff.js",
    "public/staff/award-flow.js",
    "public/staff/customer-surface.js",
    "public/staff/index.js",
    "public/staff/page-context.js",
    "public/staff/program-rules.js",
    "public/staff/redeem-flow.js",
    "public/staff/scanner.js",
    "public/staff/security-actions.js",
    "public/staff/service-mounts.js",
    "public/staff/session.js",
    "public/staff/types.ts",
    "public/staff/wallet-actions.js",
    "public/staff/wallet-panel.js",
    "public/super/account-security.js",
    "public/super/business-card.js",
    "public/super/businesses.js",
    "public/super/index.js",
    "public/super/magic-links.js",
    "public/super/page-context.js",
    "public/super/owner-progress-settings.js",
    "public/super/plans.js",
    "public/super/security-posture.js",
    "public/super/session.js",
    "public/super/types.ts",
    "public/types.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
